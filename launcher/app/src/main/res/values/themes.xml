<resources>
    <style name="Theme.EGate" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:alertDialogTheme">@style/Theme.EGate.Dialog</item>
    </style>

    <style name="Theme.EGate.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowMinWidthMajor">46%</item>
        <item name="android:windowMinWidthMinor">46%</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
