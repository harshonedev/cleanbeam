<resources>
    <style name="Theme.Projector" parent="Theme.AppCompat.NoActionBar">
        <!-- Launch splash only: the activity paints its own background and drops this one. -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textViewStyle">@style/Widget.Projector.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Projector.EditText</item>
    </style>

    <style name="Widget.Projector.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="Widget.Projector.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>
</resources>
