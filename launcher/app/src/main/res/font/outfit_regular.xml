<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit at weight 400, built once per process. fontVariationSettings on each TextView would
     rebuild the variable font per view (about 10 ms each on a TV CPU). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/outfit"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        tools:targetApi="28" />
</font-family>
