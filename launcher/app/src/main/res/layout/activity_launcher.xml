<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- ambient art: two layers crossfade when the focused app changes -->
    <ImageView
        android:id="@+id/bg_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/bg_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <View
        android:id="@+id/tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scrim_left_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:id="@+id/scrim_bottom_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="28dp">

        <!-- tabs -->
        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView android:id="@+id/tab_home" style="@style/Tab" android:text="@string/tab_home" />
            <TextView android:id="@+id/tab_apps" style="@style/Tab" android:layout_marginStart="18dp" android:text="@string/tab_apps" />
            <TextView android:id="@+id/tab_favorites" style="@style/Tab" android:layout_marginStart="18dp" android:text="@string/tab_favorites" />
            <TextView android:id="@+id/tab_settings" style="@style/Tab" android:layout_marginStart="18dp" android:text="@string/tab_settings" />
        </LinearLayout>

        <View
            android:id="@+id/tab_underline"
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:background="@drawable/tab_underline"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            app:layout_constraintStart_toStartOf="@id/tabs" />

        <!-- clock + wifi -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@id/tabs"
            app:layout_constraintBottom_toBottomOf="@id/tabs"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                tools:text="9:26 PM" />

            <ImageView
                android:id="@+id/wifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/phone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_phone"
                android:visibility="gone"
                android:contentDescription="Phone remote connected" />
        </LinearLayout>


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/shelf_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.56" />

        <!-- hero -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginBottom="6dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/shelf_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintWidth_percent="0.62">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Prime Video" />

            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Video app, version 3.0.412" />

            <TextView
                android:id="@+id/hero_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="Last opened 2 hours ago" />

            <TextView
                android:id="@+id/hero_body"
                android:layout_width="wrap_content"
                android:maxWidth="520dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="A retired hitman is pulled back in." />
        </LinearLayout>

        <!-- Apps / Settings tabs: vertical grid below the hero, same slot as the Home shelves -->
        <io.egate.launcher.FocusGridRecyclerView
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="47dp"
            android:paddingEnd="40dp"
            android:paddingBottom="400dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/shelf_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- app row -->
        <io.egate.launcher.FocusRowRecyclerView
            android:id="@+id/row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="47dp"
            android:paddingEnd="900dp"
            app:layout_constraintTop_toTopOf="@id/shelf_top"
            app:layout_constraintStart_toStartOf="parent" />

        <io.egate.launcher.ShelvesRecyclerView
            android:id="@+id/shelves"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/shelf_top"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/row"
            app:layout_constraintBottom_toBottomOf="@id/row"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_favorites"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_favorites_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>


        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="RAM 1.2G free   Storage 9G free" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
