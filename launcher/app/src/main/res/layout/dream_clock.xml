<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- the user's picture, when there is one, and a flat dim over it -->
    <ImageView
        android:id="@+id/dream_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/dream_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/dream_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/dream_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extralight"
                android:textColor="#FFFFFF"
                android:shadowColor="#99000000"
                android:shadowRadius="12"
                android:textSize="150sp" />

            <TextView
                android:id="@+id/dream_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="28dp"
                android:textColor="#C8CCDC"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dream_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#C8CCDC"
            android:shadowColor="#99000000"
            android:shadowRadius="8"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
