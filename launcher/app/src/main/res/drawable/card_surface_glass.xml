<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted card for themes with a picture behind it: a translucent white fill and a thin rim.
     Flat colours only; a blur or a gradient would cost the Mali-450 a shader per card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
</shape>
